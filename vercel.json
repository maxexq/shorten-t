{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/cron/sync-clicks",
      "destination": "/api/cron/sync-clicks"
    },
    {
      "source": "/(.*)",
      "destination": "/src/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-clicks",
      "schedule": "0 0 * * *"
    }
  ]
}
